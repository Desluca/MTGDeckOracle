{
  "name": "mtg-deck-oracle",
  "version": "0.1.0",
  "private": true,
  "description": "Commander deck analysis and scoring engine.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
