PORT=5174

# Local development can omit DATABASE_URL and use .cache/rating-lab-db.json.
# Production should set a PostgreSQL connection string.
DATABASE_URL=postgres://user:password@host:5432/mtgdeckoracle

# Most managed PostgreSQL providers require SSL. Set to false only for local Docker/Postgres.
POSTGRES_SSL=true

# Optional local JSON store path when DATABASE_URL is not set.
RATING_LAB_DB_PATH=.cache/rating-lab-db.json
